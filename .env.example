# 複製此檔為 .env 後依環境調整。.env 不會進版控。

# ── 網站 ─────────────────────────────────────────────
# 對外網址，用於 canonical、sitemap、OG url。正式 / 測試環境務必設定。
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 後端 API（未來 Spring Boot）───────────────────────
# 伺服器端（SSR / prerender）呼叫後端的位址。容器環境改為內網位址。
NUXT_API_BASE=http://localhost:8080/api

# 瀏覽器端呼叫的位址。預設 /api，之後由 Nitro 同源代理到 NUXT_API_BASE，
# 可避免 CORS 並隱藏內網位址。若要讓前端直連後端，改成完整網址。
NUXT_PUBLIC_API_BASE=/api

# ── 登入 / Session ───────────────────────────────────
# Session cookie 加密金鑰，至少 32 字元。dev 模式 nuxt-auth-utils 會自動產生寫入 .env。
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-at-least-32-chars

# Google OAuth（在 https://console.cloud.google.com/apis/credentials 建立「OAuth 用戶端 ID」）
# 授權重新導向 URI 設為： http://localhost:3000/auth/google
# 未填時，開發模式的「登入」按鈕會使用假登入（不連 Google）。
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# ── 真實資料來源 ─────────────────────────────────────
# 台股上市股票的日 K / 週 K / 昨收 取自臺灣證券交易所（免費、盤後）。
# 設為 false 可完全改用示範資料（離線 / CI 用）。
NUXT_TWSE_ENABLED=true
